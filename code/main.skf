// skyforge-array

функция уникальные(список) {
    пусть рез = []
    для э в список {
        пусть найден = ложь
        для р в рез {
            если э == р { найден = истина }
        }
        если не найден { рез = рез + [э] }
    }
    вернуть рез
}

функция разбить_на_куски(список, размер) {
    пусть рез = []
    пусть текущий = []
    для э в список {
        текущий = текущий + [э]
        если длина(текущий) == размер {
            рез = рез + [текущий]
            текущий = []
        }
    }
    если длина(текущий) > 0 { рез = рез + [текущий] }
    вернуть рез
}
